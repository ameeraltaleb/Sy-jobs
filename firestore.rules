rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Allow public read access to settings for site configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ameeraltaleb@gmail.com';
    }

    // Jobs collection hardening
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.email == 'ameeraltaleb@gmail.com';
    }
  }
}
